{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/check-events",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/process-events",
      "schedule": "0 9 * * *"
    }
  ]
}
