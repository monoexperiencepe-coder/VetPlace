{
  "name": "vetplace-platform",
  "private": true,
  "workspaces": [
    "web",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:vet":    "npm run dev --workspace=web",
    "dev:barber": "npm run dev --workspace=apps/barberplace",
    "dev:dental": "npm run dev --workspace=apps/dentalplace",
    "dev:carwash":"npm run dev --workspace=apps/carwashplace",
    "build":      "turbo build",
    "lint":       "turbo lint",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
